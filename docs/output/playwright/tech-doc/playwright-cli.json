{
  "browser": {
    "browserName": "chromium",
    "launchOptions": {
      "headless": true,
      "channel": "chrome",
      "args": [
        "--use-fake-ui-for-media-stream",
        "--use-fake-device-for-media-stream"
      ]
    },
    "contextOptions": {
      "viewport": { "width": 1280, "height": 900 },
      "deviceScaleFactor": 2,
      "permissions": ["microphone"]
    }
  }
}
